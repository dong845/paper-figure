{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "paper-figure figure card (spec \u00a76.2): one real method figure, described in text only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "paper_url",
    "venue",
    "year",
    "domains",
    "figure",
    "figure_type",
    "layout_pattern",
    "flow_direction",
    "grouping",
    "shapes_depth",
    "elements",
    "proposed_highlight",
    "lesson",
    "source",
    "measured"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,80}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "paper_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "venue": {
      "type": "string",
      "minLength": 2
    },
    "year": {
      "type": "integer",
      "minimum": 1980,
      "maximum": 2100
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "figure": {
      "type": "integer",
      "minimum": 1
    },
    "figure_type": {
      "enum": [
        "overview",
        "teaser",
        "module-detail",
        "composite",
        "other"
      ]
    },
    "layout_pattern": {
      "enum": [
        "linear-pipeline",
        "u-shape",
        "multi-branch",
        "two-stage-stacked",
        "side-by-side-comparison",
        "encoder-decoder",
        "loop",
        "grid-of-panels",
        "hub-and-spoke",
        "nested-zoom",
        "other"
      ]
    },
    "layout_note": {
      "type": "string"
    },
    "flow_direction": {
      "enum": [
        "left-to-right",
        "top-to-bottom",
        "right-to-left",
        "bottom-to-top",
        "radial",
        "mixed"
      ]
    },
    "grouping": {
      "type": "string",
      "minLength": 3
    },
    "shapes_depth": {
      "type": "string",
      "minLength": 3
    },
    "elements": {
      "type": "array",
      "items": {
        "enum": [
          "thumbnail",
          "icon",
          "equation",
          "feature-map-3d",
          "token-sequence",
          "plot",
          "text-box",
          "image-grid",
          "matrix",
          "graph",
          "operator-glyph",
          "arrow-labels",
          "legend",
          "brackets",
          "callout",
          "shape-labels",
          "other"
        ]
      }
    },
    "proposed_highlight": {
      "type": "string",
      "minLength": 3
    },
    "lesson": {
      "type": "string",
      "minLength": 10
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_url",
        "figure",
        "read"
      ],
      "properties": {
        "paper_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "figure": {
          "type": "integer",
          "minimum": 1
        },
        "read": {
          "type": "string",
          "minLength": 3
        },
        "date": {
          "type": "string"
        }
      }
    },
    "measured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "palette",
        "whitespace_ratio",
        "ink_ratio",
        "aspect",
        "size_px"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^computed:"
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hex",
              "share",
              "neutral"
            ],
            "properties": {
              "hex": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "neutral": {
                "type": "boolean"
              }
            }
          }
        },
        "whitespace_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ink_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "aspect": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "size_px": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "photo_share": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "arrangement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition",
        "units",
        "inputs_at",
        "losses_at",
        "legend_at"
      ],
      "description": "how the figure is arranged at the top level — what a run copies as its layout skeleton (plan layout.skeleton_from). Written by looking at the crop",
      "properties": {
        "partition": {
          "enum": [
            "single",
            "lanes",
            "stage-panels",
            "parallel-panels",
            "lane-grid"
          ],
          "description": "as the plan's layout.partition"
        },
        "units": {
          "type": "string",
          "minLength": 3,
          "description": "what each enclosed region holds and how it is enclosed (frame, tint band, dashed rule, whitespace)"
        },
        "inputs_at": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom",
            "both-sides",
            "inside"
          ]
        },
        "inputs_as": {
          "type": "string",
          "description": "how inputs are shown (real photos, quoted text, a stack of samples, an icon)"
        },
        "losses_at": {
          "type": "string",
          "minLength": 3,
          "description": "where each objective sits relative to the unit that optimises it"
        },
        "shared": {
          "type": "string",
          "description": "how a module used by two units is drawn (a copy per unit marked shared, one box with links …)"
        },
        "legend_at": {
          "enum": [
            "none",
            "corner",
            "bottom",
            "right",
            "top",
            "left",
            "inside"
          ],
          "description": "none = lines labelled directly; inside = a key between content (observed, not recommended)"
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "paradigm",
        "paradigm_source",
        "architecture",
        "training",
        "modality",
        "depicts",
        "task"
      ],
      "description": "method facets in kb/taxonomy.json's vocabulary (checked by code): what a run retrieves by (`kb match`)",
      "properties": {
        "family": {
          "type": "string"
        },
        "paradigm": {
          "type": "string",
          "minLength": 2,
          "description": "the founding method this figure's method builds on, by its common name (CLIP, SAM, LLaVA, DETR, U-Net, Transformer, DDPM, NeRF, MAE, ReAct, RAG …); the method itself when it is the source"
        },
        "paradigm_source": {
          "type": "boolean",
          "description": "true when this paper IS the paradigm's source (CLIP's own figure)"
        },
        "architecture": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "training": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "modality": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "depicts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "task": {
          "type": "string",
          "minLength": 3
        },
        "note": {
          "type": "string",
          "description": "required when any value is 'other': what it is"
        }
      }
    },
    "structure": {
      "type": "object",
      "description": "references/derive.md: what this figure draws as structure — the core relation and its form, every relation's spatial form, what each channel means, and how well it is designed. kb forms finds published drawings of a relation by this",
      "additionalProperties": false,
      "required": ["core", "relations", "channels", "quality"],
      "properties": {
        "core": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relation", "what"],
          "properties": {
            "relation": {"enum": ["sequence", "pairing", "shared", "streams", "stages", "iteration", "fusion", "retrieval", "on-structure", "zoom", "alternatives"]},
            "what": {"type": "string", "minLength": 8, "description": "the relation the figure makes visible first, and the form it takes"}
          }
        },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "form"],
            "properties": {
              "type": {"enum": ["sequence", "pairing", "shared", "streams", "stages", "iteration", "fusion", "retrieval", "on-structure", "zoom", "alternatives"]},
              "form": {"type": "string", "minLength": 8, "description": "how this figure draws that relation, in one specific clause"}
            }
          }
        },
        "channels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["colour"],
          "properties": {
            "colour": {"type": "string"},
            "shape": {"type": "string"},
            "line": {"type": "string"},
            "frame": {"type": "string"}
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "strengths", "weaknesses"],
          "properties": {
            "score": {"type": "integer", "minimum": 1, "maximum": 5, "description": "1 weak … 5 exemplary, judged on the five principles of references/derive.md"},
            "strengths": {"type": "string", "minLength": 8},
            "weaknesses": {"type": "string"}
          }
        }
      }
    },
    "insights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structure",
        "data",
        "emphasis",
        "flow"
      ],
      "description": "what to learn from this figure, one specific sentence per aspect, and what not to copy",
      "properties": {
        "structure": {
          "type": "string",
          "minLength": 8
        },
        "data": {
          "type": "string",
          "minLength": 8
        },
        "emphasis": {
          "type": "string",
          "minLength": 8
        },
        "flow": {
          "type": "string",
          "minLength": 8
        },
        "avoid": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "fetch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figure"
      ],
      "description": "how to get the figure again (no local image cache): an arXiv id, or an open-access PDF url with a short cache key",
      "properties": {
        "arxiv_id": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{4,5}$"
        },
        "pdf_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "figure": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox_pt": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          },
          "description": "the crop box on `page` in PDF points (x0, y0, x1, y1; origin top-left): fetch-crop restores exactly this crop"
        }
      }
    }
  }
}