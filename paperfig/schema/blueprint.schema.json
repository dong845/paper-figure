{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "paper-figure blueprint",
  "type": "object",
  "required": ["schema_version", "figure", "root"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "figure": {
      "type": "object",
      "required": ["type", "venue", "width"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["overview", "teaser", "module-detail"]},
        "venue": {"type": "string", "minLength": 1},
        "width": {"oneOf": [{"enum": ["single", "double"]}, {"type": "number", "exclusiveMinimum": 0, "maximum": 20}]},
        "label_language": {"type": "string"},
        "legend": {"enum": ["auto", "none"]},
        "title": {"type": "string"},
        "style": {"type": "string"},
        "legend_notes": {"type": "array", "items": {"type": "string"}},
        "highlight": {"enum": ["fill", "outline"], "description": "how the contribution stands out: tinted fill (default) or a heavy outline on white"},
        "legend_labels": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}, "description": "rename legend entries: proposed, an edge kind, a badge, an op"}
      }
    },
    "root": {"$ref": "#/$defs/group"},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "discrepancies": {"type": "array", "items": {"type": "object"}},
    "annotations": {"type": "array", "items": {
      "type": "object", "required": ["id", "kind", "covers", "label"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["bracket"]},
        "covers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "label": {"type": "string"},
        "placement": {"enum": ["outer", "inner"], "description": "outer = the figure's top/bottom lane; inner = right above/below what it covers (between rows; needs a gap that fits it)"},
        "side": {"enum": ["top", "bottom"]},
        "provenance": {"$ref": "#/$defs/provenance"}
      }}},
    "notes": {"type": "string"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "ref"],
        "additionalProperties": false,
        "properties": {"source": {"enum": ["draft", "code", "user"]}, "ref": {"type": "string", "minLength": 1}}
      }
    },
    "cell": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2},
    "span": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
    "role": {"enum": ["proposed", "reused", "io", "data", "loss", "op", "annotation"]},
    "element": {"if": {"required": ["children"]}, "then": {"$ref": "#/$defs/group"}, "else": {"$ref": "#/$defs/node"}},
    "group": {
      "type": "object",
      "required": ["id", "children"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string"},
        "role": {"$ref": "#/$defs/role"},
        "tone": {"type": "string"},
        "full_name": {"type": "string"},
        "abbrev": {"type": "string"},
        "frame": {"enum": ["box", "dashed", "none"]},
        "axis_of": {"type": "string"},
        "align_x": {"type": "string", "description": "after layout, shift this element (and its contents) so it lines up with that node horizontally (a group lines up its axis_of child)"},
        "align_y": {"type": "string", "description": "the same, vertically"},
        "detail_of": {"type": "string"},
        "title_align": {"enum": ["left", "center"]},
        "place": {"enum": ["grid", "free"]},
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["row", "column", "grid", "cycle", "canvas"]},
            "cols": {"type": "integer", "minimum": 2, "maximum": 24, "description": "canvas: the number of equal columns (default 12)"},
            "hub": {"type": "string", "description": "cycle: the child placed inside the loop (e.g. the LLM an agent loop revolves around)"},
            "align": {"enum": ["start", "center", "end"]},
            "gap": {"enum": ["none", "tight", "normal", "loose"]},
            "equalize": {"type": "boolean"}
          }
        },
        "children": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
        "provenance": {"$ref": "#/$defs/provenance"},
        "cell": {"$ref": "#/$defs/cell"},
        "span": {"$ref": "#/$defs/span"}
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string"},
        "role": {"$ref": "#/$defs/role"},
        "visual": {"enum": ["box", "tensor", "tokens", "image", "icon", "op", "text", "placeholder", "trapezoid", "stack", "slab", "glyph", "textcard", "chip"]},
        "glyph": {"enum": ["graph", "database", "prototype", "heatmap", "mask", "kspace", "documents", "pointcloud", "waveform", "spectrogram", "trajectory", "molecule", "plot"]},
        "variant": {"type": "string"},
        "card_style": {"enum": ["plain", "code", "bubble"], "description": "textcard: plain text, code (monospace), or a speech bubble"},
        "nodes": {"type": "integer", "minimum": 3, "maximum": 8},
        "pattern": {"enum": ["cartesian", "radial", "random"]},
        "illustrative": {"type": "boolean"},
        "taper": {"enum": ["in", "out", "down", "up"]},
        "stub": {"type": "object", "additionalProperties": false, "required": ["side"], "properties": {"side": {"enum": ["left", "right", "top", "bottom"]}, "label": {"type": "string"}}, "description": "a short outgoing arrow (a panel's output with no drawn target)"},
        "place": {"enum": ["grid", "free"]},
        "sheets": {"type": "integer", "minimum": 2, "maximum": 6},
        "op": {"enum": ["add", "mul", "matmul", "concat", "reshape", "gelu"]},
        "tone": {"type": "string"},
        "full_name": {"type": "string"},
        "abbrev": {"type": "string"},
        "badges": {"type": "array", "items": {"enum": ["frozen", "trainable"]}, "uniqueItems": true},
        "icon": {"type": "string"},
        "asset": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string"},
            "status": {"enum": ["provided", "from-code", "requested", "placeholder"]},
            "spec": {"type": "string"}
          }
        },
        "size": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 2, "maxItems": 2},
        "tokens": {"type": "integer", "minimum": 1, "maximum": 32},
        "align_x": {"type": "string", "description": "after layout, shift this element (and its contents) so it lines up with that node horizontally (a group lines up its axis_of child)"},
        "align_y": {"type": "string", "description": "the same, vertically"},
        "values": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "description": "tokens: one value per cell, drawn as its shade (e.g. attention weights)"},
        "accent": {"type": "boolean", "description": "glyph: false keeps the accent colour out of it (one colour, one meaning)"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "cell": {"$ref": "#/$defs/cell"},
        "span": {"$ref": "#/$defs/span"}
      }
    },
    "edge": {
      "type": "object",
      "required": ["src", "dst"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "src": {"type": "string"},
        "dst": {"type": "string"},
        "kind": {"enum": ["data", "skip", "loss", "train_only", "infer_only", "grad", "control"]},
        "label": {"type": "string"},
        "src_side": {"enum": ["auto", "left", "right", "top", "bottom"]},
        "tone": {"type": "string", "description": "a semantic tone for this one path (declare it in color_semantics)"},
        "dst_side": {"enum": ["auto", "left", "right", "top", "bottom"]},
        "curved": {"type": "boolean", "description": "draw as a smooth curve through the routed bends"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}
