{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "reference-scout output (refs.json)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "paper_excluded",
  "queries",
  "selected",
  "rejected",
  "notes"
 ],
 "properties": {
  "paper_excluded": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title"
   ],
   "properties": {
    "arxiv_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "title": {
     "type": "string"
    }
   }
  },
  "queries": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "query",
     "results"
    ],
    "properties": {
     "query": {
      "type": "string"
     },
     "years": {
      "type": [
       "string",
       "null"
      ]
     },
     "venues": {
      "type": [
       "array",
       "null"
      ]
     },
     "results": {
      "type": "integer",
      "minimum": 0
     },
     "notes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "selected": {
   "type": "array",
   "maxItems": 10,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "title",
     "url",
     "why",
     "figure",
     "crop",
     "caption",
     "viewed"
    ],
    "properties": {
     "title": {
      "type": "string"
     },
     "arxiv_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "type": "string",
      "pattern": "^https?://"
     },
     "venue": {
      "type": [
       "string",
       "null"
      ]
     },
     "year": {
      "type": [
       "integer",
       "null"
      ]
     },
     "why": {
      "type": "string",
      "minLength": 5
     },
     "figure": {
      "type": "integer",
      "minimum": 1
     },
     "crop": {
      "type": "string"
     },
     "caption": {
      "type": "string"
     },
     "viewed": {
      "type": "boolean"
     },
     "venue_source": {
      "enum": [
       "semantic-scholar",
       "arxiv-journal-ref",
       "pdf",
       "unverified"
      ]
     },
     "card": {
      "type": [
       "string",
       "null"
      ]
     },
     "role": {
      "enum": [
       "paradigm",
       "neighbour",
       "method"
      ],
      "description": "paradigm = the source figure of the method family this paper extends (CLIP for contrastive image-text pretraining); neighbour (default) = a similar recent method; method = a knowledge-base figure of the same method architecture found by `kb match` (give its `card`)"
     }
    }
   }
  },
  "rejected": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "title",
     "why"
    ],
    "properties": {
     "title": {
      "type": "string"
     },
     "why": {
      "type": "string"
     }
    }
   }
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "paradigm": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "family",
    "source",
    "selected"
   ],
   "description": "the method family's founding paper whose figure readers already know; its depiction of the core mechanism is what the plan borrows",
   "properties": {
    "family": {
     "type": "string",
     "minLength": 3
    },
    "source": {
     "type": "string",
     "minLength": 2
    },
    "selected": {
     "type": "boolean"
    },
    "why_not": {
     "type": [
      "string",
      "null"
     ]
    },
    "metaphor": {
     "type": [
      "string",
      "null"
     ],
     "description": "how the source figure draws the mechanism (CLIP: an N×N image-text similarity matrix, positives on the diagonal)"
    }
   }
  },
  "method_route": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "query",
    "hits",
    "used"
   ],
   "description": "the second retrieval route: figures of the same method (paradigm, family, architecture, training) from the knowledge base (`kb match`), beside the content search",
   "properties": {
    "query": {
     "type": "object"
    },
    "hits": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "used": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "why_not": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  }
 }
}