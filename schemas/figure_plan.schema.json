{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "figure_plan.json — what the figure tells the reader",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "takeaway",
    "concepts",
    "chosen",
    "why",
    "core",
    "highlight",
    "data_visuals",
    "omitted"
  ],
  "properties": {
    "takeaway": {
      "type": "string",
      "minLength": 10
    },
    "reader_questions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "glance": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "adapts",
          "takes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "adapts": {
            "type": "string",
            "minLength": 1
          },
          "takes": {
            "type": "string",
            "minLength": 3
          },
          "sketch": {
            "type": "string"
          }
        }
      }
    },
    "chosen": {
      "type": "string",
      "minLength": 1
    },
    "why": {
      "type": "string",
      "minLength": 5
    },
    "core": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "highlight": {
      "type": "string",
      "minLength": 3
    },
    "data_visuals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "visual",
          "source"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "visual": {
            "enum": [
              "image",
              "feature-map",
              "tokens",
              "text-example",
              "plot",
              "graph",
              "other"
            ]
          },
          "source": {
            "enum": [
              "repo",
              "dataset",
              "public-sample",
              "code-output",
              "thumbnail",
              "placeholder",
              "none"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "licence": {
            "type": [
              "string",
              "null"
            ]
          },
          "for": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact",
          "reason",
          "where"
        ],
        "properties": {
          "fact": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 3
          },
          "where": {
            "enum": [
              "text",
              "detail-panel",
              "other-figure",
              "caption"
            ]
          }
        }
      }
    },
    "drawn_as": {
      "type": "array",
      "description": "paper components the figure draws as part of another element: into = a node (or one copy per timestep), on_edge = a label on that edge",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ids",
          "how"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "into": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "on_edge": {
            "type": "string",
            "minLength": 1
          },
          "how": {
            "type": "string",
            "minLength": 3
          }
        },
        "oneOf": [
          {
            "required": [
              "into"
            ]
          },
          {
            "required": [
              "on_edge"
            ]
          }
        ]
      }
    },
    "deviations": {
      "type": "array",
      "description": "paperfig/rules.py: tier-2 design defaults this figure departs from on purpose — each with why and evidence (a knowledge-base card, a selected reference, the author's own figure, or the user's instruction). Invariants (faithful, legible, printable) cannot be listed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "why", "evidence"],
        "properties": {
          "rule": {"type": "string", "description": "a lint code (e.g. ink-heavy, palette-busy, aspect-tall) or a plan rule (plan:...)"},
          "why": {"type": "string"},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": {"enum": ["card", "reference", "user-draft", "user"]},
              "ref": {"type": "string", "description": "card id / arXiv id or title / 'user-draft' / the user's words"}
            }
          }
        }
      }
    },
    "omitted_details": {
      "type": "array",
      "description": "details left out that are not stated facts (a head, an extra conv, a variant)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "reason",
          "where"
        ],
        "properties": {
          "what": {
            "type": "string",
            "minLength": 2
          },
          "reason": {
            "type": "string",
            "minLength": 3
          },
          "where": {
            "enum": [
              "text",
              "detail-panel",
              "other-figure",
              "caption"
            ]
          }
        }
      }
    },
    "brief_version": {
      "enum": [
        1,
        2
      ],
      "description": "2 = the design Brief of the user's guide (three reading levels)"
    },
    "problem": {
      "type": "string",
      "minLength": 10
    },
    "io": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "outputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "solves",
          "shown_by",
          "ids"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "solves": {
            "type": "string",
            "minLength": 3
          },
          "shown_by": {
            "type": "string",
            "minLength": 3
          },
          "ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "mechanism": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "explains",
          "ids"
        ],
        "properties": {
          "explains": {
            "type": "string",
            "minLength": 3
          },
          "ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "panel": {
            "type": "string",
            "minLength": 1
          },
          "equations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "train_only": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "infer_kept": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "key_representations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "ids"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "visual": {
            "type": "string",
            "minLength": 1
          },
          "tone": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "color_semantics": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 2
      }
    },
    "annotate": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": [
            "string",
            "number"
          ]
        },
        "formats": {
          "type": "array",
          "items": {
            "enum": [
              "pdf",
              "png",
              "svg"
            ]
          }
        }
      }
    },
    "color_by": {
      "enum": [
        "modality",
        "role",
        "stage",
        "type"
      ],
      "description": "what the fill colour encodes: modality (image / text / audio sides of a multi-modal model; the contribution then gets figure.highlight 'ring'), role (proposed vs reused), stage, or entity type"
    },
    "supervision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "how"
      ],
      "description": "how the figure shows what is supervised against what (which pairs are positive) when the method trains with two or more contrastive / matching objectives; ids drawn, or why_not",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "how": {
          "type": "string",
          "minLength": 3
        },
        "why_not": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "expanded_despite_figure": {
      "type": "array",
      "description": "modules the text shows in their own figure but this overview still expands, with the reason",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "depth": {
      "type": "array",
      "description": "design.md § How deep the overview goes: per proposed module, the level the overview draws it at — inline (its few parts drawn in place on the main line), box (one named box with a line under its name; the internals stay in the text or the paper's own figure), inset (a named box plus one zoom-in panel in this figure, detail_of the box), own-figure (a named box marked 'Fig. N' plus a module figure of its own, made by `paperfig split`)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "as", "why"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "description": "the module's component id (the box the overview draws)"},
          "as": {"enum": ["inline", "box", "inset", "own-figure"]},
          "why": {"type": "string", "minLength": 5, "description": "its size (the analysis' inner_parts), whether the 2-minute reader needs it, whether the text gives it a subsection or figure of its own"},
          "panel": {"type": "string", "minLength": 1, "description": "inset / own-figure: the detail_of group that draws its internals"},
          "section": {"type": "string", "minLength": 1, "description": "own-figure: the section the module figure accompanies (e.g. 'Sec. 3.2')"},
          "figure": {"type": "integer", "minimum": 1, "description": "own-figure: its number in the paper, written on the overview's box as '(Fig. N)' (default: 2, 3, … in panel order)"}
        }
      }
    },
    "structure": {
      "type": "object",
      "description": "references/derive.md: the figure derived from the method before any reference — the core relation the reader must see, every relation with its spatial form, what each visual channel means, where the space goes. References calibrate it afterwards",
      "additionalProperties": false,
      "required": ["core", "relations", "channels", "budget"],
      "properties": {
        "core": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relation", "ids", "why"],
          "properties": {
            "relation": {"enum": ["sequence", "pairing", "shared", "streams", "stages", "iteration", "fusion", "retrieval", "on-structure", "zoom", "alternatives"]},
            "ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "why": {"type": "string", "minLength": 3}
          }
        },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "ids", "form"],
            "properties": {
              "type": {"enum": ["sequence", "pairing", "shared", "streams", "stages", "iteration", "fusion", "retrieval", "on-structure", "zoom", "alternatives"]},
              "ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "description": "pairing: [objective, one side, other side]; sequence: in flow order"},
              "form": {"type": "string", "minLength": 3}
            }
          }
        },
        "channels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["colour"],
          "properties": {
            "colour": {"type": "string", "minLength": 3},
            "shape": {"type": "string"},
            "line": {"type": "string"},
            "frame": {"type": "string"}
          }
        },
        "budget": {"type": "string", "minLength": 3}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skeleton_from",
        "takes",
        "partition",
        "why",
        "inputs_at",
        "legend_at"
      ],
      "description": "the figure's arrangement, learned from a reference figure: its top-level partition (one enclosed unit per stream / stage / objective the text separates, each drawing its own losses), where the inputs enter, where the key sits. See references/layout.md",
      "properties": {
        "skeleton_from": {
          "type": "string",
          "minLength": 1,
          "description": "the reference figure whose arrangement this follows (a knowledge-base card id, a card of this run, or a selected reference: arXiv id / title), or \"derived\" when the arrangement comes from the plan's structure and no reference draws it (references/derive.md)"
        },
        "takes": {
          "type": "string",
          "minLength": 3,
          "description": "what of its arrangement is taken (e.g. one lane per stream, each ending in its own loss)"
        },
        "partition": {
          "enum": [
            "single",
            "lanes",
            "stage-panels",
            "parallel-panels",
            "lane-grid"
          ],
          "description": "single = one composition; lanes = one horizontal band per stream / branch; stage-panels = one framed panel per stage, left to right; parallel-panels = side-by-side panels of the same structure (one per objective or variant); lane-grid = streams as rows x stages as columns"
        },
        "why": {
          "type": "string",
          "minLength": 3
        },
        "units": {
          "type": "array",
          "description": "one per enclosed region of the partition: the blueprint group id, the analysis stage / stream it draws, and the loss nodes drawn inside it",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "of": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "job": {
                "enum": [
                  "teach",
                  "extend",
                  "same",
                  "compare"
                ],
                "description": "references/layout.md § 0b: teach = draws its objectives in full (matrices); extend = reuses an earlier unit's objectives compactly (loss boxes fed from both sides) and spends its space on what is new; same = a parallel unit drawn identically; compare = set against another unit to show a difference (a teaser's 'prior work vs ours', references/derive.md § 4). Required when there are two or more units"
              },
              "losses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "not_drawn": {
          "type": "array",
          "description": "a loss the analysis runs in a stream that the stream's unit does not draw, with the reason",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "loss",
              "unit",
              "why"
            ],
            "properties": {
              "loss": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "why": {
                "type": "string",
                "minLength": 3
              }
            }
          }
        },
        "inputs_at": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom",
            "both-sides",
            "inside"
          ]
        },
        "legend_at": {
          "enum": [
            "auto",
            "corner",
            "bottom",
            "right",
            "top",
            "none"
          ],
          "description": "where the key sits (figure.legend_at in the blueprint; none = figure.legend none, lines labelled directly)"
        },
        "links": {
          "type": "array",
          "description": "edges allowed to cross from one unit to another (a shared-weights link, a cross-stream loss)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "src",
              "dst",
              "why"
            ],
            "properties": {
              "src": {
                "type": "string"
              },
              "dst": {
                "type": "string"
              },
              "why": {
                "type": "string",
                "minLength": 3
              }
            }
          }
        }
      }
    }
  }
}
