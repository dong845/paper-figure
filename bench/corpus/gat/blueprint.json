 "discrepancies": [
  {
   "what": "how the attention score a^T[W h_i || W h_j] is computed",
   "draft": "concatenate W h_i and W h_j, then project with the weight vector a (Eq. 3)",
   "code": "a is split into two width-1 convs: f_1 = conv1d(seq_fts, 1, 1) for i and f_2 for j, added by broadcasting (utils/layers.py:14-16); no explicit concatenation",
   "decision": "draw the paper's form (\u2016 then a\u1d40); a^T[x\u2016y] = a_1^T x + a_2^T y, so the drawing is exact"
  },
  {
   "what": "where masked attention acts",
   "draft": "'we only compute e_ij for nodes j \u2208 N_i' (Sec. 2.1)",
   "code": "scores are computed for all N\u00d7N pairs and bias_mat is added after LeakyReLU, before the softmax (utils/layers.py:17)",
   "decision": "draw the paper's statement: the neighbourhood N_i restricts which pairs enter the attention mechanism (edge 'j \u2208 N_i' into \u2016); the additive mask gives the same \u03b1_ij"
  },
  {
   "what": "final nonlinearity after averaging the heads",
   "draft": "Eq. (6) applies \u03c3 (softmax or logistic sigmoid) after averaging",
   "code": "the output layer uses the identity activation and returns the averaged logits (models/gat.py:27-31); the softmax is outside the repository",
   "decision": "draw \u03c3 after Mean_k as the paper states"
  },
  {
   "what": "code-only parts of a head",
   "draft": "not described in Sec. 2.1",
   "code": "a bias after aggregation (layers.py:25), an optional residual with a 1\u00d71 projection (layers.py:28-32) and dropout on the input, on \u03b1 and on W h (layers.py:9, 20, 22)",
   "decision": "not drawn; listed in the plan's omitted_details (dropout mentioned in the caption)"
  },
  {
   "what": "role of h'",
   "draft": "the layer's output (io)",
   "code": "an intermediate tensor h_1 of the network (models/gat.py:15); the model returns logits",
   "decision": "drawn as the layer's output, which is what the module-detail figure shows"
  }
 ],
