  },
  {
   "id": "inp->add",
   "from": "inp",
   "to": "add",
   "quote": "degraded image is added: Î = I + R",
   "ref": "Sec. 3"
  },
  {
   "id": "add->out",
   "from": "add",
   "to": "out",
   "quote": "obtain the restored image Î",
   "ref": "Sec. 3"
  },
  {
   "id": "mdta->gdfn",
   "from": "mdta",
   "to": "gdfn",
   "quote": "core components of the proposed Transformer block: (a) MDTA and (b) GDFN",
