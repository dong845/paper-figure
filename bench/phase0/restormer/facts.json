{
 "facts": [
  {
   "id": "inp->embed",
   "from": "inp",
   "to": "embed",
   "quote": "first applies a convolution to obtain low-level feature embeddings F0",
   "ref": "Sec. 3"
  },
  {
   "id": "embed->enc1",
   "from": "embed",
   "to": "enc1",
   "quote": "shallow features F0 pass through a 4-level symmetric encoder-decoder",
   "ref": "Sec. 3"
  },
  {
   "id": "enc1->enc2",
   "from": "enc1",
   "to": "enc2",
   "quote": "the encoder hierarchically reduces spatial size",
   "ref": "Sec. 3"
  },
  {
   "id": "enc2->enc3",
   "from": "enc2",
   "to": "enc3",
   "quote": "hierarchically reduces spatial size",
   "ref": "Sec. 3"
  },
  {
   "id": "enc3->latent",
   "from": "enc3",
   "to": "latent",
   "quote": "decoder takes low-resolution latent features Fl",
   "ref": "Sec. 3"
  },
  {
   "id": "latent->dec3",
   "from": "latent",
   "to": "dec3",
   "quote": "progressively recovers the high-resolution representations",
   "ref": "Sec. 3"
  },
  {
   "id": "dec3->dec2",
   "from": "dec3",
   "to": "dec2",
   "quote": "progressively recovers",
   "ref": "Sec. 3"
  },
  {
   "id": "dec2->dec1",
   "from": "dec2",
   "to": "dec1",
   "quote": "progressively recovers",
   "ref": "Sec. 3"
  },
  {
   "id": "enc1->dec1",
   "from": "enc1",
   "to": "dec1",
   "quote": "encoder features are concatenated with the decoder features via skip connections",
   "ref": "Sec. 3"
  },
  {
   "id": "enc2->dec2",
   "from": "enc2",
   "to": "dec2",
   "quote": "concatenated ... via skip connections",
   "ref": "Sec. 3"
  },
  {
   "id": "enc3->dec3",
   "from": "enc3",
   "to": "dec3",
   "quote": "concatenated ... via skip connections",
   "ref": "Sec. 3"
  },
  {
   "id": "dec1->refine",
   "from": "dec1",
   "to": "refine",
   "quote": "deep features Fd are further enriched in the refinement stage",
   "ref": "Sec. 3"
  },
  {
   "id": "refine->outconv",
   "from": "refine",
   "to": "outconv",
   "quote": "a convolution layer is applied to the refined features to generate residual image R",
